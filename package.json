{
  "name": "dsh-jev-subagent-dispatch",
  "version": "0.1.4",
  "description": "Cut LLM costs: route routine tasks to cheap subagent models (DeepSeek Harness plugin)",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "README.md",
    "bin/jev-replay.mjs",
    "capabilities.mjs",
    "config.mjs",
    "cordis.patch.yml",
    "index.mjs",
    "jev.mjs",
    "replay.mjs",
    "verdict.mjs"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "node scripts/check.mjs",
    "check": "npm run lint && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "routing",
    "jev",
    "typesafe"
  ],
  "bin": {
    "jev-replay": "./bin/jev-replay.mjs"
  }
}
